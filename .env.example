# --- SpeakerSpice server configuration (copy to .env) ---
PORT=8788

# REQUIRED in production: session signing secret (any long random string)
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public base URL of the server (used in OAuth callbacks + reset links)
BETTER_AUTH_URL=http://localhost:8788

# Optional: bearer token protecting the /mcp endpoint
SPEAKERSPICE_TOKEN=

# --- Social sign-in (each provider appears in the UI only when configured) ---
# Google:   https://console.cloud.google.com/apis/credentials
#           redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple (requires paid Apple developer account):
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# GitHub:   https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Password-reset email (link is logged to console when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SpeakerSpice <no-reply@example.com>"
